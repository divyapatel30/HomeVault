rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      function isOwnershipTransferTarget() {
        let familyId = resource.data.familyId;
        let familyPath =
          /databases/$(database)/documents/families/$(familyId);
        let familyBefore = get(familyPath).data;
        let familyAfter = getAfter(familyPath).data;
        let currentOwnerAfter = getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;

        return familyId is string
               && familyBefore.ownerId == request.auth.uid
               && userId in familyBefore.members
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly(["familyRole"])
               && request.resource.data.familyId == familyId
               && request.resource.data.familyRole == "owner"
               && familyAfter.ownerId == userId
               && familyAfter.members == familyBefore.members
               && currentOwnerAfter.familyId == familyId
               && currentOwnerAfter.familyRole == "member";
      }

      function isOwnerRemovingFamilyMember() {
        let familyId = resource.data.familyId;
        let familyPath =
          /databases/$(database)/documents/families/$(familyId);
        let familyBefore = get(familyPath).data;
        let familyAfter = getAfter(familyPath).data;

        return familyId is string
               && request.auth.uid != userId
               && familyBefore.ownerId == request.auth.uid
               && userId in familyBefore.members
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly(["familyId", "familyRole"])
               && request.resource.data.familyId == null
               && request.resource.data.familyRole == null
               && familyAfter.members is list
               && familyBefore.members.size()
                    == familyAfter.members.size() + 1
               && familyBefore.members.hasAll(familyAfter.members)
               && !(userId in familyAfter.members);
      }

      function isFamilyPeer() {
        let signedInUser = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;
        let familyId = signedInUser.familyId;

        return familyId is string
               && resource.data.familyId == familyId
               && get(
                 /databases/$(database)/documents/families/$(familyId)
               ).data.members.hasAll([request.auth.uid, userId]);
      }

      allow create: if request.auth != null
                    && request.auth.uid == userId;

      allow read: if request.auth != null
                  && (
                    request.auth.uid == userId
                    || isFamilyPeer()
                  );

      allow update: if request.auth != null
                    && (
                      request.auth.uid == userId
                      || isOwnerRemovingFamilyMember()
                      || isOwnershipTransferTarget()
                    );

      allow delete: if false;

      match /documentNameReservations/{nameKey} {
        allow get: if request.auth != null
                   && request.auth.uid == userId;

        allow list: if false;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.ownerId == userId
                      && request.resource.data.documentId is string
                      && request.resource.data.createdAt == request.time
                      && getAfter(
                        /databases/$(database)/documents/documents/$(request.resource.data.documentId)
                      ).data.ownerId == userId
                      && getAfter(
                        /databases/$(database)/documents/documents/$(request.resource.data.documentId)
                      ).data.documentNameKey == nameKey;

        allow update: if false;

        allow delete: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.ownerId == userId
                      && (
                        !existsAfter(
                          /databases/$(database)/documents/documents/$(resource.data.documentId)
                        )
                        || getAfter(
                          /databases/$(database)/documents/documents/$(resource.data.documentId)
                        ).data.documentNameKey != nameKey
                      );
      }
    }

    match /userNotifications/{notificationId} {
      function isFamilyMemberRemovalNotification() {
        let familyId = request.resource.data.familyId;
        let recipientId = request.resource.data.recipientId;
        let familyPath =
          /databases/$(database)/documents/families/$(familyId);
        let familyBefore = get(familyPath).data;
        let familyAfter = getAfter(familyPath).data;
        let recipientAfter = getAfter(
          /databases/$(database)/documents/users/$(recipientId)
        ).data;

        return familyId is string
               && recipientId is string
               && recipientId != request.auth.uid
               && familyBefore.ownerId == request.auth.uid
               && recipientId in familyBefore.members
               && familyAfter.members is list
               && familyBefore.members.size()
                    == familyAfter.members.size() + 1
               && familyBefore.members.hasAll(familyAfter.members)
               && !(recipientId in familyAfter.members)
               && recipientAfter.familyId == null
               && recipientAfter.familyRole == null;
      }

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      "recipientId",
                      "familyId",
                      "familyName",
                      "type",
                      "dismissed",
                      "createdAt"
                    ])
                    && request.resource.data.keys().hasAll([
                      "recipientId",
                      "familyId",
                      "familyName",
                      "type",
                      "dismissed",
                      "createdAt"
                    ])
                    && request.resource.data.familyName is string
                    && request.resource.data.type == "family-member-removed"
                    && request.resource.data.dismissed == false
                    && request.resource.data.createdAt == request.time
                    && isFamilyMemberRemovalNotification();

      allow read: if request.auth != null
                  && resource.data.recipientId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.recipientId == request.auth.uid
                    && resource.data.dismissed == false
                    && request.resource.data.dismissed == true
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(["dismissed"]);

      allow delete: if false;
    }

    match /documents/{documentId} {
      function isDocumentOwner() {
        return request.auth != null
               && resource.data.ownerId == request.auth.uid;
      }

      function isActiveFamilyDocument() {
        return request.auth != null
               && get(
                 /databases/$(database)/documents/users/$(request.auth.uid)
               ).data.familyId is string
               && resource.data.familyId
                    == get(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.familyId
               && resource.data.isDeleted == false
               && resource.data.sharedWithFamily == true
               && get(
                 /databases/$(database)/documents/families/$(resource.data.familyId)
               ).data.members.hasAll([request.auth.uid])
               && (
                 resource.data.accessLevel == "family"
                 || (
                   resource.data.accessLevel == "selected"
                   && request.auth.uid in resource.data.sharedWithMemberIds
                 )
               );
      }

      function isFamilyOwnerOfSharedDocument() {
        return request.auth != null
               && resource.data.familyId is string
               && get(
                 /databases/$(database)/documents/users/$(request.auth.uid)
               ).data.familyId == resource.data.familyId
               && resource.data.sharedWithFamily == true
               && resource.data.accessLevel in ["family", "selected"]
               && get(
                 /databases/$(database)/documents/families/$(resource.data.familyId)
               ).data.ownerId == request.auth.uid;
      }

      function isFamilyOwnerRevokingOrphanedDocument() {
        let familyPath =
          /databases/$(database)/documents/families/$(resource.data.familyId);
        let familyData = get(familyPath).data;

        return request.auth != null
               && resource.data.familyId is string
               && get(
                 /databases/$(database)/documents/users/$(request.auth.uid)
               ).data.familyId == resource.data.familyId
               && familyData.ownerId == request.auth.uid
               && !(resource.data.ownerId in familyData.members)
               && resource.data.sharedWithFamily == true
               && resource.data.accessLevel in ["family", "selected"]
               && request.resource.data.ownerId == resource.data.ownerId
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly([
                      "accessLevel",
                      "familyId",
                      "sharedWithMemberIds",
                      "sharedWithFamily",
                      "updatedAt"
                    ])
               && request.resource.data.accessLevel == "private"
               && request.resource.data.familyId == null
               && request.resource.data.sharedWithMemberIds is list
               && request.resource.data.sharedWithMemberIds.size() == 0
               && request.resource.data.sharedWithFamily == false
               && request.resource.data.updatedAt == request.time;
      }

      function hasValidSharingSettings() {
        return (
          request.resource.data.accessLevel == "private"
          && request.resource.data.familyId == null
          && request.resource.data.sharedWithMemberIds.size() == 0
          && request.resource.data.sharedWithFamily == false
        ) || (
          request.resource.data.accessLevel == "family"
          && request.resource.data.familyId is string
          && request.resource.data.familyId
               == get(
                 /databases/$(database)/documents/users/$(request.auth.uid)
               ).data.familyId
          && request.resource.data.sharedWithMemberIds.size() == 0
          && request.resource.data.sharedWithFamily == true
          && get(
            /databases/$(database)/documents/families/$(request.resource.data.familyId)
          ).data.members.hasAll([request.auth.uid])
        ) || (
          request.resource.data.accessLevel == "selected"
          && request.resource.data.familyId is string
          && request.resource.data.familyId
               == get(
                 /databases/$(database)/documents/users/$(request.auth.uid)
               ).data.familyId
          && request.resource.data.sharedWithMemberIds is list
          && request.resource.data.sharedWithMemberIds.size() > 0
          && request.resource.data.sharedWithFamily == true
          && get(
            /databases/$(database)/documents/families/$(request.resource.data.familyId)
          ).data.members.hasAll([request.auth.uid])
          && get(
            /databases/$(database)/documents/families/$(request.resource.data.familyId)
          ).data.members.hasAll(request.resource.data.sharedWithMemberIds)
        );
      }

      function hasNameReservation() {
        return request.resource.data.documentNameKey is string
               && getAfter(
                 /databases/$(database)/documents/users/$(request.auth.uid)/documentNameReservations/$(request.resource.data.documentNameKey)
               ).data.ownerId == request.auth.uid
               && getAfter(
                 /databases/$(database)/documents/users/$(request.auth.uid)/documentNameReservations/$(request.resource.data.documentNameKey)
               ).data.documentId == documentId;
      }

      function isDocumentDetailsUpdate() {
        return isDocumentOwner()
               && request.resource.data.ownerId == request.auth.uid
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly([
                      "fileName",
                      "documentNameKey",
                      "category",
                      "expiryDate",
                      "accessLevel",
                      "sharedWithMemberIds",
                      "familyId",
                      "sharedWithFamily",
                      "updatedAt"
                    ])
               && request.resource.data.fileName is string
               && request.resource.data.fileName.size() > 0
               && request.resource.data.fileName.size() <= 100
               && request.resource.data.category is string
               && request.resource.data.accessLevel
                    in ["private", "family", "selected"]
               && request.resource.data.sharedWithMemberIds is list
               && request.resource.data.sharedWithFamily is bool
               && hasValidSharingSettings()
               && request.resource.data.updatedAt == request.time
               && hasNameReservation();
      }

      function isDocumentTrashUpdate() {
        return isDocumentOwner()
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly([
                      "isDeleted",
                      "deletedAt"
                    ])
               && (
                 (
                   request.resource.data.isDeleted == true
                   && request.resource.data.deletedAt == request.time
                 )
                 ||
                 (
                   request.resource.data.isDeleted == false
                   && request.resource.data.deletedAt == null
                 )
               );
      }

      allow get, list: if isDocumentOwner()
                       || isActiveFamilyDocument()
                       || isFamilyOwnerOfSharedDocument();

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      "ownerId",
                      "ownerName",
                      "uploadedBy",
                      "uploaderName",
                      "uploaderRole",
                      "fileName",
                      "originalFileName",
                      "category",
                      "documentNameKey",
                      "expiryDate",
                      "accessLevel",
                      "sharedWithMemberIds",
                      "familyId",
                      "sharedWithFamily",
                      "storageBucket",
                      "storagePath",
                      "filePath",
                      "contentType",
                      "fileSize",
                      "isDeleted",
                      "createdAt",
                      "updatedAt"
                    ])
                    && request.resource.data.ownerName is string
                    && request.resource.data.uploaderName is string
                    && request.resource.data.uploaderRole
                         in ["owner", "family_member"]
                    && request.resource.data.uploaderRole
                         == (
                           get(
                             /databases/$(database)/documents/users/$(request.auth.uid)
                           ).data.familyRole == "member"
                             ? "family_member"
                             : "owner"
                         )
                    && request.resource.data.fileName is string
                    && request.resource.data.documentNameKey is string
                    && request.resource.data.originalFileName is string
                    && request.resource.data.category is string
                    && request.resource.data.accessLevel
                         in ["private", "family", "selected"]
                    && request.resource.data.sharedWithMemberIds is list
                    && request.resource.data.sharedWithFamily is bool
                    && hasValidSharingSettings()
                    && request.resource.data.storageBucket is string
                    && request.resource.data.storagePath is string
                    && request.resource.data.storagePath.split("/")[0]
                         == request.auth.uid
                    && request.resource.data.filePath
                         == request.resource.data.storagePath
                    && request.resource.data.contentType is string
                    && request.resource.data.fileSize is int
                    && request.resource.data.fileSize >= 0
                    && request.resource.data.isDeleted == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && hasNameReservation();

      allow update: if isDocumentDetailsUpdate()
                    || isDocumentTrashUpdate()
                    || isFamilyOwnerRevokingOrphanedDocument();

      allow delete: if isDocumentOwner()
                    && resource.data.isDeleted == true;
    }

    match /families/{familyId} {
      function isOwnershipTransfer() {
        let newOwnerId = request.resource.data.ownerId;

        return request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(["ownerId"])
               && resource.data.ownerId == request.auth.uid
               && newOwnerId is string
               && newOwnerId != request.auth.uid
               && newOwnerId in resource.data.members
               && request.resource.data.members == resource.data.members
               && getAfter(
                 /databases/$(database)/documents/users/$(newOwnerId)
               ).data.familyId == familyId
               && getAfter(
                 /databases/$(database)/documents/users/$(newOwnerId)
               ).data.familyRole == "owner"
               && getAfter(
                 /databases/$(database)/documents/users/$(request.auth.uid)
               ).data.familyId == familyId
               && getAfter(
                 /databases/$(database)/documents/users/$(request.auth.uid)
               ).data.familyRole == "member";
      }

      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members == [request.auth.uid]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 50
                    && getAfter(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.familyId == familyId
                    && getAfter(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.familyRole == "owner";

      allow update: if request.auth != null
                    && (
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(["members"])
                        && request.resource.data.members is list
                        && (
                          (
                            request.resource.data.members.size()
                              == resource.data.members.size() + 1
                            && request.resource.data.members.hasAll(resource.data.members)
                            && !(request.auth.uid in resource.data.members)
                            && request.auth.uid in request.resource.data.members
                            && getAfter(
                              /databases/$(database)/documents/users/$(request.auth.uid)
                            ).data.familyId == familyId
                            && getAfter(
                              /databases/$(database)/documents/users/$(request.auth.uid)
                            ).data.familyRole
                              == (resource.data.ownerId == request.auth.uid
                                ? "owner"
                                : "member")
                          )
                          ||
                          (
                            resource.data.ownerId != request.auth.uid
                            && resource.data.members.size()
                              == request.resource.data.members.size() + 1
                            && resource.data.members.hasAll(request.resource.data.members)
                            && request.auth.uid in resource.data.members
                            && !(request.auth.uid in request.resource.data.members)
                          )
                          ||
                          (
                            resource.data.ownerId == request.auth.uid
                            && request.auth.uid in request.resource.data.members
                            && resource.data.members.size()
                              == request.resource.data.members.size() + 1
                            && resource.data.members.hasAll(request.resource.data.members)
                          )
                        )
                      )
                      ||
                      isOwnershipTransfer()
                    );

      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && resource.data.members is list
                    && resource.data.members.size() == 1
                    && request.auth.uid in resource.data.members
                    && getAfter(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.familyId == null
                    && getAfter(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.familyRole == null;
    }
  }
}
